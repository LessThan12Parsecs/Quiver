{
  "name": "quiver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Physics-based surfing game built on Three.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:gpu": "tsx tools/runGpuCheck.ts",
    "shots": "tsx tools/screenshot.ts",
    "smoke": "tsx tools/smoke.ts"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
